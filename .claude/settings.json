{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm --filter @antartida/react-ui typecheck *)",
      "Bash(pnpm --filter @antartida/react-ui test *)",
      "Bash(pnpm --filter @antartida/core test *)",
      "Bash(pnpm --filter @antartida/core typecheck *)",
      "mcp__codegraph__codegraph_explore"
    ],
    "deny": [
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/verify.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/format.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/bug-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
