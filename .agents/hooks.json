{
  "project-verify": {
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/verify.sh",
        "timeout": 300
      }
    ]
  },
  "project-format": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/format.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "project-no-push": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/agent-config/bin/guard-agy.sh --no-push",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
